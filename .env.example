# Copy to .env (never commit .env). Values intentionally blank.
ADAPTER_BRAND_ID=amrit_dairy
ADAPTER_DATABASE_URL=sqlite:///./adapter.db
# Shopify (Amrit Dairy store). 2026 model: Dev Dashboard app in the SAME organization as the store -> client credentials grant
# (24 h tokens, renewed automatically). SHOPIFY_WEBHOOK_SECRET may stay blank: the client secret signs this app's webhooks.
SHOPIFY_SHOP_DOMAIN=kmaz1y-dq.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Store is a merchant (non-dev) store -> install via authorization-code grant: open ADAPTER_PUBLIC_URL/shopify/auth/start?token=<INBOX_WEBHOOK_TOKEN>
# once; the offline token is stored in the DB and used instead of client credentials.
ADAPTER_PUBLIC_URL=https://adapter.amritdairy.in
# Optional alternatives: a non-expiring offline token (authorization-code grant / still-valid legacy app) and an explicit webhook secret
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
# Razorpay (verify this is the Amrit Dairy merchant account before use)
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Shiprocket: static token configured at Settings > API > Webhooks (sent as x-api-key). Treated as a HINT only.
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
# Replies go out through the BiteSpeed support console (Chatwoot API). Token: chat.bitespeed.co -> Profile settings -> Access Token.
CHATWOOT_BASE_URL=https://chat.bitespeed.co
CHATWOOT_ACCOUNT_ID=3122
CHATWOOT_API_TOKEN=
# BiteSpeed marketing/template send API: no public contract (2026-10-11); not used.
BITESPEED_API_KEY=
# Support console (account 3122) outbound webhook: register https://<host>/webhooks/inbox/<token>
INBOX_WEBHOOK_TOKEN=
# Gateway test: only these numbers may send TESTPAY (creates a ₹10 custom-item draft -> real Razorpay checkout -> orders/paid webhook)
TEST_PHONE_ALLOWLIST=+918814869007
TEST_PAYMENT_MINOR=1000
FLOW_KEYWORDS_YIELD=ghee,घी,ghi,bilona,बिलोना,desi ghee,cow ghee,golden ghee,honey,shahad,शहद,milk,doodh,दूध
SENDER_MODE=dry_run   # dry_run | live_test (replies only to TEST_PHONE_ALLOWLIST) | live
# Operating policy (owner-approved values only; defaults are the kit's PROPOSALS)
PROMO_WINDOW_START=09:00
PROMO_WINDOW_END=20:00
PROMO_MAX_PER_24H=1
PROMO_MAX_PER_7D=2
ABANDONED_CHECKOUT_FIRST_DELAY_MIN=45
# Budget guard (INR). Leave blank = kill switch engaged for promotional sends.
BUDGET_MONTHLY_CAP_INR=
OPERATIONAL_RESERVE_INR=
GLOBAL_KILL_SWITCH=true
# COD geometry file (GeoJSON FeatureCollection with zone_id properties). Missing file = no COD auto-approval.
COD_ZONES_GEOJSON=./config/cod_zones.geojson
# Internal alert destination (email/webhook) – disabled until approved
ALERT_DESTINATION=
REPORTS_ENABLED=false
